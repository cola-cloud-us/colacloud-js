{
  "name": "colacloud",
  "version": "1.5.1",
  "description": "Official JavaScript/TypeScript SDK for the COLA Cloud API - access the TTB COLA Registry of alcohol product label approvals",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "dependencies:age": "node scripts/check-dependency-age.mjs",
    "dependencies:audit": "npm audit --omit=dev --package-lock-only --audit-level=moderate && node scripts/audit-build-tools.mjs"
  },
  "keywords": [
    "cola",
    "ttb",
    "alcohol",
    "beverage",
    "label",
    "api",
    "sdk",
    "typescript"
  ],
  "author": "COLA Cloud",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cola-cloud-us/colacloud-js.git"
  },
  "homepage": "https://colacloud.us",
  "bugs": {
    "url": "https://github.com/cola-cloud-us/colacloud-js/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": "12.0.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "packageManager": "npm@12.0.2"
}
